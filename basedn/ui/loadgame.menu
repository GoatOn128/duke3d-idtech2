// Load game. Slots 0 to 10; slot 0 is the auto slot.
{
	name "loadgame"
	fullscreen 1
	focuscolor 1 1 1 1
	onOpen { duke readsave ; setfocus load_0 }
	onESC { play item15.wav ; slideclose 640 0 10 16 ; open main }

	itemDef {
		name "load_header"
		ownerdraw 1
		decoration
		visible 1
	}

	itemDef {
		name "load_title"
		ownerdraw 113
		decoration
		visible 1
	}

	itemDef {
		name "load_0"
		rect 190 62.4 320 33.6
		ownerdraw 64
		visible 1
		action { play kickhit.wav ; duke load 0 }
	}

	itemDef {
