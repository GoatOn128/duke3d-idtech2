// Load game. Slots 0 to 10; slot 0 is the auto slot.
{
	name "loadgame"
	fullscreen 1
	focuscolor 1 1 1 1
	onOpen { duke readsave ; setfocus load_0 }
	onESC { play item15.wav ; close loadgame ; open main }

	itemDef {
		name "load_header"
		ownerdraw 1
		rect 112 16.8 416 33.6
		decoration
		visible 1
	}

	itemDef {
		name "load_title"
		ownerdraw 113
		rect 112 28.8 416 38.4
		decoration
		visible 1
	}

	itemDef {
