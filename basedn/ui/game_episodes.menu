// Episode select. The header tile and the title line are decorations.
{
	name "game_episodes"
	fullscreen 1
	focuscolor 1 1 1 1
	onOpen { setfocus episode_0 }
	onESC { play item15.wav ; close game_episodes ; open main }

	itemDef {
		name "ep_header"
		ownerdraw 1
		decoration
		visible 1
	}

	itemDef {
		name "ep_title"
		ownerdraw 23
		decoration
		visible 1
	}

	itemDef {
		name "episode_0"
		rect 70 134.4 500 48
		ownerdraw 24
		visible 1
		action { play kickhit.wav ; setcvar dn_episode 1 ; close game_episodes ; open game_skills }
	}

	itemDef {
		name "episode_1"
		rect 70 182.4 500 48
		ownerdraw 25
		visible 1
		action { play kickhit.wav ; setcvar dn_episode 2 ; close game_episodes ; open game_skills }
	}

	itemDef {
		name "episode_2"
		rect 70 230.4 500 48
		ownerdraw 26
		visible 1
		action { play kickhit.wav ; setcvar dn_episode 3 ; close game_episodes ; open game_skills }
	}

	itemDef {
		name "episode_3"
		rect 70 278.4 500 48
		ownerdraw 27
		visible 1
		action { play kickhit.wav ; setcvar dn_episode 4 ; close game_episodes ; open game_skills }
	}
}
