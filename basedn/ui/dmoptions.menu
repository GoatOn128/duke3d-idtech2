// Deathmatch flags. The rows paint from the module dmflags table and
// cycle through the ownerdraw key handler.
{
	name "dmoptions"
	fullscreen 1
	focuscolor 1 1 1 1
	onOpen { setfocus dm_0 }
	onESC { play item15.wav ; close dmoptions ; open startserver }

	itemDef {
		name "dm_title"
		ownerdraw 126
		decoration
		visible 1
	}

	itemDef {
		name "dm_0"
		rect 16 68 260 28
		ownerdraw 96
		visible 1
		action { play bulithit.wav }
