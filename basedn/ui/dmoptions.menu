// Deathmatch flags. The rows paint from the module dmflags table and
// cycle through the ownerdraw key handler.
{
	name "dmoptions"
	fullscreen 1
	focuscolor 1 1 1 1
	onOpen { setfocus dm_0 }
	onESC { play item15.wav ; slideclose 640 0 10 16 ; open startserver }

	itemDef {
		name "dm_header"
		ownerdraw 1
		decoration
		visible 1
	}

	itemDef {
		name "dm_title"
		ownerdraw 126
		decoration
		visible 1
	}

