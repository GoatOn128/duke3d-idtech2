// Multiplayer root.
{
	name "multiplayer"
	fullscreen 1
	focuscolor 1 1 1 1
	onOpen { setfocus mp_join }
	onESC { play item15.wav ; slideclose 640 0 10 16 ; open main }

	itemDef {
		name "mp_header"
		ownerdraw 1
		decoration
		visible 1
	}

	itemDef {
		name "mp_title"
		ownerdraw 114
		decoration
		visible 1
	}

	itemDef {
		name "mp_join"
		rect 144 120 416 38.4
		ownerdraw 115
		visible 1
		action { play kickhit.wav ; slideclose -640 0 10 16 ; open joinserver }
	}

	itemDef {
		name "mp_start"
		rect 144 158.4 416 38.4
		ownerdraw 116
		visible 1
		action { play kickhit.wav ; slideclose -640 0 10 16 ; open startserver }
	}

	itemDef {
		name "mp_setup"
		rect 144 196.8 416 38.4
		ownerdraw 117
		visible 1
		action { play kickhit.wav ; slideclose -640 0 10 16 ; open playerconfig }
	}
}
