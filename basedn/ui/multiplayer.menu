// Multiplayer root.
{
	name "multiplayer"
	fullscreen 1
	focuscolor 1 1 1 1
	onOpen { setfocus mp_join }
	onESC { play item15.wav ; close multiplayer ; open main }

	itemDef {
		name "mp_header"
		ownerdraw 1
		rect 112 16.8 416 33.6
		decoration
		visible 1
	}

	itemDef {
		name "mp_title"
		ownerdraw 114
		rect 112 28.8 416 38.4
		decoration
		visible 1
	}

	itemDef {
		name "mp_join"
		rect 112 124.8 416 38.4
		ownerdraw 115
		visible 1
		action { play kickhit.wav ; close multiplayer ; open joinserver }
	}

	itemDef {
		name "mp_start"
		rect 112 163.2 416 38.4
		ownerdraw 116
		visible 1
		action { play kickhit.wav ; close multiplayer ; open startserver }
	}

	itemDef {
		name "mp_setup"
		rect 112 201.6 416 38.4
		ownerdraw 117
		visible 1
		action { play kickhit.wav ; close multiplayer ; open playerconfig }
	}
}
