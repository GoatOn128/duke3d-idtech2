// Address book. Edit fields write the adrN cvars on every keystroke,
// so the engine address book persists without a close hook.
{
	name "addressbook"
	fullscreen 1
	focuscolor 1 1 1 1
	onOpen { setfocus adr_0 }
	onESC { play item15.wav ; close addressbook ; open joinserver }

	itemDef {
		name "ab_header"
		ownerdraw 1
		decoration
		visible 1
	}

	itemDef {
		name "adr_title"
		ownerdraw 122
		decoration
		visible 1
	}

	itemDef {
		name "adr_0"
		type 4
		text "ADR 0"
		cvar "adr0"
		rect 80 80 480 28
		textscale 1
		forecolor 0.45 0.45 0.45 1
		maxChars 60
		maxPaintChars 30
		visible 1
	}

	itemDef {
		name "adr_1"
		type 4
		text "ADR 1"
		cvar "adr1"
		rect 80 112 480 28
		textscale 1
		forecolor 0.45 0.45 0.45 1
		maxChars 60
		maxPaintChars 30
		visible 1
	}

