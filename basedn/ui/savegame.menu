// Save game. Slot 0 is the auto slot and only loads, so the save menu
// lists slots 1 to 10; slot text comes from the save headers at runtime.
{
	name "savegame"
	fullscreen 1
	focuscolor 1 1 1 1
	onOpen { duke readsave ; setfocus save_1 }
	onESC { play item15.wav ; close savegame ; open main }

	itemDef {
		name "save_header"
		ownerdraw 1
		decoration
		visible 1
	}

	itemDef {
		name "save_title"
		ownerdraw 112
		decoration
		visible 1
	}

	itemDef {
		name "save_1"
		rect 190 96 320 33.6
		ownerdraw 65
		visible 1
		action { play kickhit.wav ; duke save 1 }
	}

	itemDef {
		name "save_2"
		rect 190 129.6 320 33.6
		ownerdraw 66
		visible 1
		action { play kickhit.wav ; duke save 2 }
	}

	itemDef {
		name "save_3"
		rect 190 163.2 320 33.6
		ownerdraw 67
		visible 1
		action { play kickhit.wav ; duke save 3 }
	}

	itemDef {
