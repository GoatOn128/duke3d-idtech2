// Player setup. The engine menu rendered a rotating player model here;
// the settings wait for a Quake 3 renderer that can draw models.
// pc_settings is a nested windowDef: the four rows inside carry rects
// relative to the container, and the parser bakes them to absolute ones.
{
	name "playerconfig"
	fullscreen 1
	focuscolor 1 1 1 1
	onOpen { setfocus pc_name }
	onESC { play item15.wav ; slideclose 640 0 10 16 ; open multiplayer }

	itemDef {
		name "pc_header"
		ownerdraw 1
		decoration
		visible 1
	}

	itemDef {
		name "pc_title"
		ownerdraw 128
		decoration
		visible 1
	}

	windowDef {
		name "pc_settings"
		rect 80 64 480 132
		decoration
		visible 1

		editDef {
			name "pc_name"
			text "name"
			cvar "name"
			rect 0 0 480 24
			textscale 1
			forecolor 0.45 0.45 0.45 1
			maxChars 16
			maxPaintChars 16
			visible 1
		}

		choiceDef {
			name "pc_hand"
			text "handedness"
			cvar "hand"
			rect 0 36 480 24
			textscale 1
			forecolor 0.45 0.45 0.45 1
			visible 1
			cvarFloatList { "right" 0 "left" 1 "center" 2 }
		}

		editDef {
			name "pc_skin"
			text "skin"
			cvar "skin"
			rect 0 72 480 24
			textscale 1
			forecolor 0.45 0.45 0.45 1
			maxChars 32
			maxPaintChars 24
			visible 1
		}

		choiceDef {
			name "pc_rate"
			text "connection"
			cvar "rate"
			rect 0 108 480 24
			textscale 1
			forecolor 0.45 0.45 0.45 1
			visible 1
			cvarFloatList { "28.8 MODEM" 2500 "33.6 MODEM" 3200 "SINGLE ISDN" 5000 "DUAL ISDN/CABLE" 10000 "T1/LAN" 25000 }
		}
	}

	itemDef {
		name "pc_downloads"
		rect 64 206.4 512 38.4
		ownerdraw 129
		visible 1
		action { play kickhit.wav ; slideclose -640 0 10 16 ; open downloadoptions }
	}
}
