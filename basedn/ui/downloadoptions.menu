// Download options. The rows sit at the 36 virtual pixel pitch of the
// other framework menus.
{
	name "downloadoptions"
	fullscreen 1
	focuscolor 1 1 1 1
	onOpen { setfocus dl_allow }
	onESC { play item15.wav ; close downloadoptions ; open playerconfig }

	itemDef {
		name "dl_header"
		ownerdraw 1
		rect 112 16.8 416 33.6
		decoration
		visible 1
	}

	itemDef {
		name "dl_title"
		ownerdraw 127
		rect 112 28.8 416 38.4
		decoration
		visible 1
	}

	itemDef {
		name "dl_allow"
		type 11
		text "allow downloading"
		cvar "allow_download"
		rect 80 64 480 24
		textscale 1
		forecolor 0.45 0.45 0.45 1
		visible 1
	}

	itemDef {
		name "dl_maps"
		type 11
		text "maps"
		cvar "allow_download_maps"
		rect 80 100 480 24
		textscale 1
		forecolor 0.45 0.45 0.45 1
		visible 1
	}

	itemDef {
		name "dl_players"
		type 11
		text "player models/skins"
		cvar "allow_download_players"
		rect 80 136 480 24
		textscale 1
		forecolor 0.45 0.45 0.45 1
		visible 1
	}

	itemDef {
		name "dl_models"
		type 11
		text "models"
		cvar "allow_download_models"
		rect 80 172 480 24
		textscale 1
		forecolor 0.45 0.45 0.45 1
		visible 1
	}

	itemDef {
		name "dl_sounds"
		type 11
		text "sounds"
		cvar "allow_download_sounds"
		rect 80 208 480 24
		textscale 1
		forecolor 0.45 0.45 0.45 1
		visible 1
	}
}
