// Join server. The server list scrolls through the LAN browser entries;
// double click connects to the selected row.
{
	name "joinserver"
	fullscreen 1
	focuscolor 1 1 1 1
	onOpen { duke refreshservers ; setfocus join_addressbook }
	onESC { play item15.wav ; close joinserver ; open multiplayer }

	itemDef {
		name "join_header"
		ownerdraw 1
		decoration
		visible 1
	}

	itemDef {
		name "join_title"
		ownerdraw 118
		decoration
		visible 1
	}

	itemDef {
		name "join_addressbook"
		rect 64 72 512 33.6
		ownerdraw 119
		visible 1
		action { play kickhit.wav ; close joinserver ; open addressbook }
	}

	itemDef {
		name "join_refresh"
		rect 64 105.6 512 38.4
		ownerdraw 120
		visible 1
		action { play kickhit.wav ; duke refreshservers }
	}

	itemDef {
		name "join_connectto"
		ownerdraw 121
		decoration
		visible 1
	}

	listDef {
		name "join_serverlist"
		feeder 2
		rect 64 172.8 512 249.6
		elementheight 31.2
		columns 2 0 192 12 224 272 16
		doubleclick { play kickhit.wav ; duke connectselected }
		textscale 1
		visible 1
	}
}
