// Quit confirmation.
{
	name "quit"
	fullscreen 1
	focuscolor 1 1 1 1
	onOpen { setfocus quit_no }
	onESC { play item15.wav ; close quit ; open main }

	itemDef {
		name "quit_header"
		ownerdraw 1
		decoration
		visible 1
	}

	itemDef {
		name "quit_title"
		ownerdraw 33
		decoration
		visible 1
	}

	itemDef {
		name "quit_yes"
		rect 250 254.4 140 48
		ownerdraw 34
		visible 1
		action { play kickhit.wav ; exec quit }
	}

	itemDef {
		name "quit_no"
		rect 250 314.4 140 48
		ownerdraw 35
		visible 1
		action { play item15.wav ; close quit ; open main }
	}
}
