// Quit confirmation.
{
	name "quit"
	fullscreen 1
	focuscolor 1 1 1 1
	onOpen { setfocus quit_no }
	onESC { play item15.wav ; close quit ; open main }

	itemDef {
		name "quit_header"
		ownerdraw 1
		rect 112 16.8 416 33.6
		decoration
		visible 1
	}

	itemDef {
		name "quit_title"
		ownerdraw 33
		rect 112 187.2 416 38.4
		decoration
		visible 1
	}

	itemDef {
		name "quit_yes"
		rect 112 259.2 416 38.4
		ownerdraw 34
		visible 1
		action { play kickhit.wav ; exec quit }
	}

	itemDef {
		name "quit_no"
		rect 112 319.2 416 38.4
		ownerdraw 35
		visible 1
		action { play item15.wav ; close quit ; open main }
	}
}
