// Options. The setting rows are framework items drawn in Duke glyphs; the
// volume and mouse speed rows are sliders, the toggles are YESNO items.
// VIDEO SETUP opens the video screen, the bottom two lines are ownerdraws
// like the main menu lines.
{
	name "options"
	fullscreen 1
	focuscolor 1 1 1 1
	onOpen { setfocus opt_sfx }
	onESC { play item15.wav ; close options ; open main }

	itemDef {
		name "opt_title"
		ownerdraw 36
		decoration
		visible 1
	}

	itemDef {
		name "opt_sfx"
		type 10
		text "effects volume"
		cvarFloat s_volume 0.5 0 1
		rect 80 64 480 24
		textscale 1
		forecolor 0.45 0.45 0.45 1
		visible 1
	}

	itemDef {
		name "opt_menumusic"
		type 11
		text "menu music"
		cvar "s_menu_music"
		rect 80 88 480 24
		textscale 1
		forecolor 0.45 0.45 0.45 1
		visible 1
	}

	itemDef {
		name "opt_musicvol"
		type 10
		text "music volume"
		cvarFloat s_musicvolume 0.5 0 1
		rect 80 112 480 24
		textscale 1
		forecolor 0.45 0.45 0.45 1
		visible 1
	}

	itemDef {
		name "opt_music"
		type 11
		text "music"
		cvar "s_music"
		rect 80 136 480 24
		textscale 1
		forecolor 0.45 0.45 0.45 1
		visible 1
	}

	itemDef {
		name "opt_sens"
		type 10
		text "mouse speed"
		cvarFloat sensitivity 3 1 11
		rect 80 160 480 24
		textscale 1
		forecolor 0.45 0.45 0.45 1
		visible 1
	}

	itemDef {
		name "opt_run"
		type 11
		text "always run"
		cvar "cl_run"
		rect 80 184 480 24
		textscale 1
		forecolor 0.45 0.45 0.45 1
		visible 1
	}

	itemDef {
		name "opt_invert"
		type 12
		text "invert mouse"
		cvar "m_pitch"
		rect 80 208 480 24
		textscale 1
		forecolor 0.45 0.45 0.45 1
		visible 1
		cvarFloatList { "no" 0.022 "yes" -0.022 }
	}

	itemDef {
		name "opt_lookspring"
		type 11
		text "lookspring"
		cvar "lookspring"
		rect 80 232 480 24
		textscale 1
		forecolor 0.45 0.45 0.45 1
		visible 1
	}

	itemDef {
		name "opt_lookstrafe"
		type 11
		text "lookstrafe"
		cvar "lookstrafe"
		rect 80 256 480 24
		textscale 1
		forecolor 0.45 0.45 0.45 1
		visible 1
	}

	itemDef {
		name "opt_freelook"
		type 11
		text "free look"
		cvar "freelook"
		rect 80 280 480 24
		textscale 1
		forecolor 0.45 0.45 0.45 1
		visible 1
	}

	itemDef {
		name "opt_crosshair"
		type 12
		text "crosshair"
		cvar "crosshair"
		rect 80 304 480 24
		textscale 1
		forecolor 0.45 0.45 0.45 1
		visible 1
		cvarFloatList { "none" 0 "cross" 1 "dot" 2 "angle" 3 }
	}

	itemDef {
		name "opt_joystick"
		type 11
		text "use joystick"
		cvar "in_joystick"
		rect 80 328 480 24
		textscale 1
		forecolor 0.45 0.45 0.45 1
		visible 1
	}

	itemDef {
		name "opt_video"
		type 1
		text "video setup"
		rect 80 376 480 24
		textscale 1
		forecolor 0.45 0.45 0.45 1
		visible 1
		action { play kickhit.wav ; close options ; open video }
	}

	itemDef {
		name "opt_controls"
		rect 80 403.2 480 33.6
		ownerdraw 37
		visible 1
		action { play kickhit.wav ; close options ; open keys }
	}

	itemDef {
		name "opt_defaults"
		rect 80 436.8 480 33.6
		ownerdraw 38
		visible 1
		action { play kickhit.wav ; exec default.cfg }
	}
}
