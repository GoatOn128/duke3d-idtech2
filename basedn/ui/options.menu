// Options. The setting rows live inside a scrollable windowDef container:
// adding an option means adding one more child itemDef, the mouse wheel
// scrolls the container when the rows outgrow the view. Rows render at
// full glyph scale like the other Duke menus, in 36 virtual pixel steps
// matching the 15 Duke pixel row pitch of the original options screen;
// the value column still lines up with the menu scope rows.
{
	name "options"
	fullscreen 1
	focuscolor 1 1 1 1
	onOpen { setfocus opt_sfx }
	onESC { play item15.wav ; close options ; open main }

	itemDef {
		name "opt_header"
		// the options screen rides the bar higher, its own header
		// placement in the original menues.c (MENUBAR at y 10)
		ownerdraw 2
		rect 112 -4.8 416 33.6
		decoration
		visible 1
	}

	itemDef {
		name "opt_title"
		ownerdraw 36
		rect 112 7.2 416 38.4
		decoration
		visible 1
	}

	windowDef {
		name "opt_scroll"
		rect 80 64 480 324
		scrollable 1
		decoration
		visible 1

		itemDef {
			name "opt_sfx"
			type 10
			text "effects volume"
			cvarFloat s_volume 0.5 0 1
			rect 0 0 480 24
			textscale 1
			forecolor 0.45 0.45 0.45 1
			visible 1
		}

		itemDef {
			name "opt_musicvol"
			type 10
			text "music volume"
			cvarFloat s_musicvolume 0.5 0 1
			rect 0 36 480 24
			textscale 1
			forecolor 0.45 0.45 0.45 1
			visible 1
		}

		itemDef {
			name "opt_music"
			type 11
			text "music"
			cvar "s_music"
			rect 0 72 480 24
			textscale 1
			forecolor 0.45 0.45 0.45 1
			visible 1
		}

		itemDef {
			name "opt_sens"
			type 10
			text "mouse speed"
			cvarFloat sensitivity 3 1 11
			rect 0 108 480 24
			textscale 1
			forecolor 0.45 0.45 0.45 1
			visible 1
		}

		itemDef {
			name "opt_run"
			type 11
			text "always run"
			cvar "cl_run"
			rect 0 144 480 24
			textscale 1
			forecolor 0.45 0.45 0.45 1
			visible 1
		}

		itemDef {
			name "opt_invert"
			type 12
			text "invert mouse"
			cvar "m_pitch"
			rect 0 180 480 24
			textscale 1
			forecolor 0.45 0.45 0.45 1
			visible 1
			cvarFloatList { "no" 0.022 "yes" -0.022 }
		}

		itemDef {
			name "opt_crosshair"
			type 11
			text "crosshair"
			cvar "crosshair"
			rect 0 216 480 24
			textscale 1
			forecolor 0.45 0.45 0.45 1
			visible 1
		}

		itemDef {
			name "opt_joystick"
			type 11
			text "use joystick"
			cvar "in_joystick"
			rect 0 252 480 24
			textscale 1
			forecolor 0.45 0.45 0.45 1
			visible 1
		}

		itemDef {
			name "opt_video"
			type 1
			text "video setup"
			rect 0 288 480 24
			textscale 1
			forecolor 0.45 0.45 0.45 1
			visible 1
			action { play kickhit.wav ; close options ; open video }
		}
	}

	itemDef {
		name "opt_controls"
		rect 112 405.6 416 38.4
		ownerdraw 37
		visible 1
		action { play kickhit.wav ; close options ; open keys }
	}

	itemDef {
		name "opt_defaults"
		rect 112 439.2 416 38.4
		ownerdraw 38
		visible 1
		action { play kickhit.wav ; exec default.cfg }
	}
}
