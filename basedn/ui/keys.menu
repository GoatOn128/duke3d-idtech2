// Customize controls. BIND items hold the command in the cvar field;
// the module refreshes the shown keys while this menu is up.
{
	name "keys"
	fullscreen 1
	focuscolor 1 1 1 1
	onOpen { setfocus key_0 }
	onESC { play item15.wav ; close keys ; open options }

	itemDef {
		name "keys_title"
		ownerdraw 40
		decoration
		visible 1
	}

	itemDef {
		name "key_0"
		type 13
		text "attack"
		cvar "+attack"
		rect 48 40 544 16
		textscale 1
		forecolor 0.45 0.45 0.45 1
		visible 1
	}

	itemDef {
		name "key_1"
		type 13
		text "next weapon"
		cvar "weapnext"
		rect 48 58 544 16
		textscale 1
