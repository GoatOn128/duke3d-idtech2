// Customize controls. The rows come from the binding feeder; enter waits
// for the new key on the selected row, escape cancels, backspace clears.
// The reset footer row writes every default binding back through the
// module resetcontrols script command.
{
	name "keys"
	fullscreen 1
	focuscolor 1 1 1 1
	onOpen { setfocus bind_list }
	onESC { play item15.wav ; close keys ; open options }

	itemDef {
		name "keys_header"
		// the controls screen rides the bar higher, its own header
		// placement in the original menues.c (MENUBAR at y 10)
		ownerdraw 2
		decoration
		visible 1
	}

	itemDef {
		name "keys_title"
		ownerdraw 40
		decoration
		visible 1
	}

	listDef {
		name "bind_list"
		feeder 1
		rect 48 40 544 340
		elementheight 20
		columns 2 0 256 16 288 224 14
		textscale 1
		visible 1
	}

	itemDef {
		name "keys_reset"
		rect 80 432 240 32
		ownerdraw 38
		visible 1
		action { play kickhit.wav ; duke resetcontrols }
	}
}
