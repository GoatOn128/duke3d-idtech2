// Duke main menu. The logo tile and the seven menu lines are ownerdraws
// painted through the engine Duke glyph helpers; the item rects place
// them, a rect centered on the screen keeps the original Duke centering.
// The slide keyword sets the screen change direction for every menu.
{
	name "main"
	fullscreen 1
	slide left
	focuscolor 1 1 1 1
	onOpen { setfocus main_new }

	itemDef {
		name "main_logo"
		ownerdraw 0
		rect 112 38.4 416 38.4
		decoration
		visible 1
	}

	itemDef {
		name "main_new"
		rect 112 132 416 38.4
		ownerdraw 16
		visible 1
		action { play kickhit.wav ; close main ; open game_episodes }
	}

	itemDef {
		name "main_save"
		rect 112 170.4 416 38.4
		ownerdraw 17
		visible 1
		cvarTest "dn_serveractive"
		enableCvar { 1 }
		action { play kickhit.wav ; close main ; open savegame }
	}

	itemDef {
		name "main_load"
		rect 112 208.8 416 38.4
		ownerdraw 18
		visible 1
		action { play kickhit.wav ; close main ; open loadgame }
	}

	itemDef {
		name "main_options"
		rect 112 247.2 416 38.4
		ownerdraw 19
		visible 1
		action { play kickhit.wav ; close main ; open options }
	}

	itemDef {
		name "main_multi"
		rect 112 285.6 416 38.4
		ownerdraw 20
		visible 1
		action { play kickhit.wav ; close main ; open multiplayer }
	}

	itemDef {
		name "main_quit"
		rect 112 362.4 416 38.4
		ownerdraw 22
		visible 1
		action { play kickhit.wav ; close main ; open quit }
	}
}
