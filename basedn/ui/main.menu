// Duke main menu. The logo tile and the seven menu lines are ownerdraws
// painted through the engine Duke glyph helpers.
{
	name "main"
	fullscreen 1
	focuscolor 1 1 1 1
	onOpen { setfocus main_new }

	itemDef {
		name "main_logo"
		ownerdraw 0
		decoration
		visible 1
	}

	itemDef {
		name "main_new"
		rect 144 127.2 416 38.4
		ownerdraw 16
		visible 1
		action { play kickhit.wav ; close main ; open game_episodes }
	}

	itemDef {
		name "main_save"
		rect 144 165.6 416 38.4
		ownerdraw 17
		visible 1
		cvarTest "dn_serveractive"
		enableCvar { 1 }
		action { play kickhit.wav ; close main ; open savegame }
	}

	itemDef {
		name "main_load"
		rect 144 204 416 38.4
		ownerdraw 18
		visible 1
		action { play kickhit.wav ; close main ; open loadgame }
	}

	itemDef {
		name "main_options"
		rect 144 242.4 416 38.4
		ownerdraw 19
		visible 1
		action { play kickhit.wav ; close main ; open options }
	}

	itemDef {
		name "main_multi"
		rect 144 280.8 416 38.4
		ownerdraw 20
		visible 1
		action { play kickhit.wav ; close main ; open multiplayer }
	}

	itemDef {
		name "main_quit"
		rect 144 357.6 416 38.4
		ownerdraw 22
		visible 1
		action { play kickhit.wav ; close main ; open quit }
	}
}
